---
// components/NavBar.astro
import { Home, Dumbbell, Zap, Armchair, GraduationCap, Salad } from 'lucide-react';

const navItems = [
  { href: '/', label: 'Inicio', icon: Home },
  { href: '/routines', label: 'Rutinas', icon: Armchair },
  { href: '/workout', label: 'Entrenar', icon: Zap },
  { href: '/foodtracker', label: 'Alimentacion', icon: Salad },
  { href: '/exercises', label: 'Ejercicios', icon: Dumbbell },
  { href: '/knowledges', label: 'Educación', icon: GraduationCap },
];
---

<!-- Desktop Nav -->
<nav class="hidden md:block bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center h-14 md:h-16">
      <a href="/" class="flex items-center gap-2 text-black font-bold text-lg md:text-xl no-underline hover:text-blue-600 transition-colors">
        <span class="text-blue-500">💪</span>
        <span>LifTiers</span>
      </a>

      <ul class="flex items-center gap-1 list-none m-0 p-0">
        {navItems.map(({ href, label, icon: Icon }) => (
          <li key={href}>
            <a
              href={href}
              data-href={href}
              class="nav-link-desktop flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium no-underline transition-all duration-200 text-gray-600 hover:text-blue-600 hover:bg-gray-50"
            >
              <Icon size={18} strokeWidth={2} class="transition-all duration-200" />
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<!-- Mobile Nav -->
<nav class="mobile-nav fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-50 shadow-lg md:hidden" id="mobile-nav">
  <div class="flex justify-around items-center h-16 px-2">
    {navItems.map((item) => {
      const Icon = item.icon;
      
      return (
        <a
          key={item.href}
          href={item.href}
          data-href={item.href}
          class="nav-link-mobile flex flex-col items-center justify-center gap-0.5 px-3 py-1 rounded-lg transition-all duration-200 relative text-gray-500 hover:text-blue-500"
        >
          <Icon size={24} strokeWidth={2} class="transition-all duration-200" />
          <span class="text-[10px] font-medium">{item.label}</span>
          <span class="absolute -top-0.5 w-6 h-0.5 bg-blue-500 rounded-full transition-all duration-200 hidden" />
        </a>
      );
    })}
  </div>
</nav>

<style>
  /* Desktop styles */
  .nav-link-desktop.active {
    @apply bg-blue-50 text-blue-600;
  }
  
  .nav-link-desktop.active .lucide {
    stroke-width: 2.5;
  }
  
  /* Mobile styles */
  .nav-link-mobile.active {
    @apply text-blue-600;
  }
  
  .nav-link-mobile.active .lucide {
    stroke-width: 2.5;
  }
  
  .nav-link-mobile.active span:last-child {
    @apply block;
  }
</style>

<script>
  function updateActiveLinks() {
    const currentPath = window.location.pathname;
    
    // Actualizar ambos tipos de enlaces
    document.querySelectorAll('.nav-link-desktop, .nav-link-mobile').forEach(link => {
      const href = link.getAttribute('data-href');
      const isActive = currentPath === href || 
                      (href !== '/' && currentPath.startsWith(href));
      
      link.classList.toggle('active', isActive);
    });
  }

  // Inicializar
  document.addEventListener('DOMContentLoaded', updateActiveLinks);
  
  // Actualizar en navegación SPA
  document.addEventListener('astro:page-load', updateActiveLinks);
  document.addEventListener('astro:after-swap', updateActiveLinks);
</script>
