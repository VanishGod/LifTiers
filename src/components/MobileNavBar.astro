---
import { Home, Dumbbell, Zap, Armchair, GraduationCap, Salad } from 'lucide-react';

const navItems = [
  { href: '/', label: 'Inicio', icon: Home },
  { href: '/routines', label: 'Rutinas', icon: Armchair },
  { href: '/workout', label: 'Entrenar', icon: Zap },
  { href: '/foodtracker', label: 'Alimentacion', icon: Salad },
  { href: '/exercises', label: 'Ejercicios', icon: Dumbbell },
  { href: '/knowledges', label: 'Educación', icon: GraduationCap },
];
---

<div class="mobile-nav-wrapper">
  <nav class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-container">
      {navItems.map((item) => {
        const Icon = item.icon;
        
        return (
          <a
            key={item.href}
            href={item.href}
            data-href={item.href}
            class="nav-link-mobile"
          >
            <Icon 
              size={24} 
              strokeWidth={2}
              class="mobile-icon"
            />
            <span class="mobile-label">
              {item.label}
            </span>
            <span class="mobile-indicator" />
          </a>
        );
      })}
    </div>
  </nav>
</div>

<style>
  /* Ocultar en desktop */
  .mobile-nav-wrapper {
    display: none !important;
  }

  @media (max-width: 767px) {
    .mobile-nav-wrapper {
      display: block !important;
    }
  }

  /* Estilos del nav */
  .mobile-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-top: 1px solid #e5e7eb;
    z-index: 50;
    box-shadow: 0 -4px 6px -1px rgba(0, 0, 0, 0.1);
    padding: 0 4px;
  }

  /* Contenedor flex con espacio uniforme */
  .mobile-nav-container {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 64px;
    max-width: 100%;
    margin: 0 auto;
  }

  /* Cada enlace - centrado perfecto */
  .nav-link-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 4px 12px;
    border-radius: 8px;
    transition: all 0.2s ease;
    color: #6b7280;
    text-decoration: none;
    position: relative;
    min-width: 56px;
    flex: 1;
    max-width: 80px;
  }

  .nav-link-mobile:hover {
    color: #3b82f6;
  }

  /* Icono */
  .mobile-icon {
    transition: all 0.2s ease;
    display: block;
    flex-shrink: 0;
  }

  /* Texto */
  .mobile-label {
    font-size: 10px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    display: block;
  }

  /* Indicador activo */
  .mobile-indicator {
    position: absolute;
    top: -1px;
    width: 20px;
    height: 3px;
    background-color: #3b82f6;
    border-radius: 9999px;
    transition: all 0.2s ease;
    display: none;
  }

  /* Estado activo */
  .nav-link-mobile.active {
    color: #2563eb;
  }

  .nav-link-mobile.active .mobile-icon {
    stroke-width: 2.5;
  }

  .nav-link-mobile.active .mobile-indicator {
    display: block;
  }
</style>

<script>
  function updateActiveMobileLink() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll('.nav-link-mobile');
    
    links.forEach(link => {
      const href = link.getAttribute('data-href');
      const isActive = currentPath === href || 
                      (href !== '/' && currentPath.startsWith(href));
      
      link.classList.toggle('active', isActive);
    });
  }

  document.addEventListener('DOMContentLoaded', updateActiveMobileLink);
  document.addEventListener('astro:page-load', updateActiveMobileLink);
  document.addEventListener('astro:after-swap', updateActiveMobileLink);
</script>
