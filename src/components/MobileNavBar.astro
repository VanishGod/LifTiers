---
import { Home, Dumbbell, Zap, Armchair, GraduationCap, Salad } from 'lucide-react';

const navItems = [
  { href: '/', label: 'Inicio', icon: Home },
  { href: '/routines', label: 'Rutinas', icon: Armchair },
  { href: '/workout', label: 'Entrenar', icon: Zap },
  { href: '/foodtracker', label: 'Alimentacion', icon: Salad },
  { href: '/exercises', label: 'Ejercicios', icon: Dumbbell },
  { href: '/knowledges', label: 'Educación', icon: GraduationCap },
];
---

<!-- ✅ MobileNavBar - Solo visible en móvil -->
<nav class="mobile-nav fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 z-50 shadow-lg md:hidden" id="mobile-nav">
  <div class="flex justify-around items-center h-16 px-2">
    {navItems.map((item) => {
      const Icon = item.icon;
      
      return (
        <a
          key={item.href}
          href={item.href}
          data-href={item.href}
          class="
            nav-link-mobile
            flex flex-col items-center justify-center gap-0.5
            px-3 py-1 rounded-lg transition-all duration-200 relative
            text-gray-500 hover:text-blue-500
          "
        >
          <Icon 
            size={24} 
            strokeWidth={2}
            class="transition-all duration-200"
          />
          <span class="text-[10px] font-medium">
            {item.label}
          </span>
          <span class="absolute -top-0.5 w-6 h-0.5 bg-blue-500 rounded-full transition-all duration-200 mobile-indicator hidden" />
        </a>
      );
    })}
  </div>
</nav>

<style>
  /* Asegurar que en desktop esté oculto */
  @media (min-width: 768px) {
    .mobile-nav {
      display: none !important;
    }
  }

  .nav-link-mobile.active {
    @apply text-blue-600;
  }
  
  .nav-link-mobile.active .lucide {
    stroke-width: 2.5;
  }
  
  .nav-link-mobile.active .mobile-indicator {
    @apply block;
  }
</style>

<script>
  function updateActiveMobileLink() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll('.nav-link-mobile');
    
    links.forEach(link => {
      const href = link.getAttribute('data-href');
      const isActive = currentPath === href || 
                      (href !== '/' && currentPath.startsWith(href));
      
      link.classList.toggle('active', isActive);
    });
  }

  document.addEventListener('DOMContentLoaded', updateActiveMobileLink);
  document.addEventListener('astro:page-load', updateActiveMobileLink);
  document.addEventListener('astro:after-swap', updateActiveMobileLink);
</script>
