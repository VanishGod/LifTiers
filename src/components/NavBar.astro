---
// components/NavBar.astro
import LogForm from "./LogForm.astro";
import { Home, Dumbbell, BookOpen, GraduationCap, Utensils, Armchair } from 'lucide-react';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Inicio', icon: Home },
  { href: '/workout', label: 'Entrenar', icon: Dumbbell },
  { href: '/exercises', label: 'Ejercicios', icon: Dumbbell },
  { href: '/knowledges', label: 'Educación', icon: GraduationCap },
  { href: '/foodtracker', label: 'Alimentacion', icon: Utensils}
];
---

<nav class="hidden md:block bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center h-14 md:h-16">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-black font-bold text-lg md:text-xl no-underline hover:text-blue-600">
        <span class="text-blue-500">{Armchair}</span>
        <span>LifTiers</span>
      </a>

      <!-- Menú Desktop (solo iconos) -->
      <ul class="flex items-center gap-1 list-none m-0 p-0">
        {navLinks.map(({ href, icon: Icon }) => {
          const isActive = currentPath === href;
          
          return (
            <li>
              <a
                href={href}
                class={`
                  flex items-center justify-center p-2.5 rounded-lg transition-all duration-200
                  ${isActive
                    ? 'bg-blue-50 text-blue-600'
                    : 'text-gray-500 hover:text-blue-600 hover:bg-gray-50'
                  }
                `}
                title={navLinks.find(l => l.href === href)?.label}
              >
                <Icon 
                  size={22} 
                  strokeWidth={isActive ? 2.5 : 2}
                />
              </a>
            </li>
          );
        })}
      </ul>

      <!-- LogForm -->
      <div class="flex items-center gap-2">
        <LogForm />
      </div>
    </div>
  </div>
</nav>