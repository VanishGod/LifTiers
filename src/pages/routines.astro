---
// pages/index.astro
import Layout from '../layouts/Layout.astro';
import { Routines as RoutinesComponent } from '@/components/react/Routines';
---

<Layout title="LifTiers - Inicio">
  <!-- Hero Section -->
  <div class="bg-linear-to-r from-blue-500 to-blue-600 text-white py-12 mb-6">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-3xl md:text-4xl font-bold mb-2">
        💪 Bienvenido a LifTiers
      </h1>
      <p class="text-blue-100 text-lg max-w-2xl mx-auto">
        Gestiona tus rutinas, registra tus entrenamientos y mejora tu rendimiento
      </p>
    </div>
  </div>

  <!-- Acciones rápidas -->
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <a href="/routines" class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-300 transition-all text-center">
        <div class="text-3xl mb-2">📋</div>
        <h3 class="font-semibold text-gray-800 text-sm">Mis Rutinas</h3>
      </a>
      <a href="/workout" class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-green-300 transition-all text-center">
        <div class="text-3xl mb-2">🏋️</div>
        <h3 class="font-semibold text-gray-800 text-sm">Entrenar</h3>
      </a>
      <a href="/exercises" class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-purple-300 transition-all text-center">
        <div class="text-3xl mb-2">📚</div>
        <h3 class="font-semibold text-gray-800 text-sm">Ejercicios</h3>
      </a>
    </div>

    <!-- ✅ Pasar la función de navegación -->
    <RoutinesComponent 
      client:load 
      onNavigateToWorkout={() => {
        window.location.href = '/workout';
      }}
    />
  </div>
</Layout>