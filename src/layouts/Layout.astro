---
// src/layouts/Layout.astro
import '../styles/global.css';
import NavBarAstroComponent from '@/components/NavBar.astro';
import MobileNavBar from '@/components/MobileNavBar.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>LifTiers</title>
	</head>
	<body>
		<!-- NavBar Desktop (oculto en móvil) -->
		<NavBarAstroComponent />

		<!-- Contenido principal -->
		<main>
			<slot />
		</main>

		<!-- MobileNavBar (solo visible en móvil) -->
		<MobileNavBar />

		<!-- Script para manejar el padding según el navbar visible -->
		<script>
			const main = document.querySelector('main');
			
			function adjustMainPadding() {
				if (main) {
					if (window.innerWidth < 768) {
						main.style.paddingBottom = '70px';
						main.style.paddingTop = '0';
					} else {
						main.style.paddingTop = '70px';
						main.style.paddingBottom = '0';
					}
				}
			}

			adjustMainPadding();
			window.addEventListener('resize', adjustMainPadding);
		</script>
	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
	}

	main {
		min-height: 100vh;
		transition: padding 0.3s ease;
	}
</style>
